{
  "realm": "haproxy-editor",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "a-haproxy-editor",
      "name": "HAProxy Editor (local SPA)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
		"*"
      ],
      "webOrigins": [
		"*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
		"post.logout.redirect.uris": "https://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "audience-a-haproxy-editor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "a-haproxy-editor",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@local",
      "firstName": "Local",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    }
  ]
}
